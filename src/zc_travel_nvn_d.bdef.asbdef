projection;
strict ( 2 );

define behavior for ZC_TRAVEL_NVN_D //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _Booking { create; }
}

define behavior for ZC_BOOKING_NVN_D //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel;
  use association _BookingSupplement { create; }
}

define behavior for ZC_SUPPLEMET_NVN_D //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}